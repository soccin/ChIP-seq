#
# Template for an analysis directory on IRIS. Clone the repo into it:
#
#   git clone git@github.com:soccin/ChIP-seq.git
#   (cd ChIP-seq && . 00.SETUP.sh)
#
# One run per analysis directory.
#

sbatch ./ChIP-seq/pipe.sh \
    --pairing-file pipeline/*_sample_pairing.txt \
    pipeline/alignments/*bam

./ChIP-seq/bin/checkRun.sh

./ChIP-seq/postPipe.sh

find out/macs | egrep "_peaks.(broad|narrow)Peak$" \
    | xargs -n 1 bsub -o SLURM.HOMER/ -J HOMER -W 59 -n 2 -M 16G \
        ./ChIP-seq/annotateWithHomer.sh

# deliverResults.sh is not ported to IRIS (00.ISSUES.md)
